{
  "name": "preve",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "node scripts/expo.cjs mobile start",
    "start:pleos": "node scripts/expo.cjs pleos start",
    "android": "node scripts/expo.cjs mobile run:android",
    "android:pleos": "node scripts/expo.cjs pleos run:android",
    "prebuild:mobile": "node scripts/expo.cjs mobile prebuild --platform android --no-install",
    "prebuild:pleos": "node scripts/expo.cjs pleos prebuild --platform android --no-install",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src config plugins scripts app.config.js",
    "export:mobile": "node scripts/expo.cjs mobile export --platform android --output-dir artifacts/mobile",
    "export:pleos": "node scripts/expo.cjs pleos export --platform android --output-dir artifacts/pleos",
    "test": "node scripts/run-tests.cjs",
    "verify:targets": "node scripts/verify-targets.cjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:mobile": "eas build --platform android --profile mobile",
    "build:pleos": "eas build --platform android --profile pleos",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-navigation/native": "^7.1.8",
    "@tabler/icons-react-native": "3.50.0",
    "expo": "~54.0.37",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.11",
    "expo-linking": "~8.0.11",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-qrcode-svg": "^6.3.45",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19.4"
  }
}
